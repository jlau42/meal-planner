# Template for .env - copy to .env and fill in. .env is git-ignored; never commit real values.
# Variables already set in your system environment take precedence over this file.

# Claude API key (https://console.anthropic.com/settings/keys) - use a workspace-scoped key.
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids (from @userinfobot) allowed to claim existing,
# not-yet-linked profiles such as "jon".
KENJI_ADMIN_TELEGRAM_IDS=
